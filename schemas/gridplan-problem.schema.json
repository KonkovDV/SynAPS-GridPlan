{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/KonkovDV/SynAPS-GridPlan/schemas/gridplan-problem.schema.json",
  "title": "GridPlanProblem",
  "type": "object",
  "required": [
    "schema_version",
    "assets",
    "crews",
    "jobs",
    "planning_horizon_start",
    "planning_horizon_end"
  ],
  "properties": {
    "schema_version": { "const": "gridplan.v1" },
    "assets": { "type": "array", "minItems": 1 },
    "crews": { "type": "array", "minItems": 1 },
    "jobs": { "type": "array", "minItems": 1 },
    "outage_windows": { "type": "array" },
    "spare_parts": { "type": "array" },
    "frozen_assignments": { "type": "array" },
    "travel_minutes": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
    "planning_horizon_start": { "type": "string", "format": "date-time" },
    "planning_horizon_end": { "type": "string", "format": "date-time" },
    "domain_attributes": { "type": "object" }
  },
  "additionalProperties": true
}
