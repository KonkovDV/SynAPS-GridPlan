{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/KonkovDV/SynAPS-GridPlan/schemas/gridplan-result.schema.json",
  "title": "GridPlanSolvePayload",
  "type": "object",
  "required": ["outcome", "schedule", "schedule_problem"],
  "properties": {
    "outcome": {
      "type": "object",
      "required": [
        "schema_version",
        "solver_config",
        "status",
        "verified_feasible",
        "hard_violation_count"
      ],
      "properties": {
        "schema_version": { "type": "string" },
        "solver_config": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["optimal", "feasible", "infeasible", "timeout", "error"]
        },
        "verified_feasible": { "type": "boolean" },
        "hard_violation_count": { "type": "integer", "minimum": 0 },
        "metadata": { "type": "object" },
        "id_map": { "type": "object" },
        "frozen_assignments": { "type": "array" }
      }
    },
    "schedule": { "type": "object" },
    "schedule_problem": { "type": "object" },
    "report": { "type": "object" },
    "diff": { "type": "object" }
  },
  "additionalProperties": true
}
